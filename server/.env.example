NODE_ENV=development
PORT=3000
SERVER_HOST=127.0.0.1
DATABASE_URL=postgresql://subscription:subscription_dev@localhost:5432/subscription?schema=public
CLIENT_URL=http://127.0.0.1:5173
SERVER_URL=http://127.0.0.1:3000
# Opaque DB sessions are used; JWT_SECRET is reserved and not required.
JWT_SECRET=
SESSION_TTL_DAYS=7
COOKIE_NAME=sid
TRUST_PROXY=0
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-random-64-character-secret
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
# Without SMTP in development, reset emails go to server/storage/mail-outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.test
# Backup key must be stored separately from ciphertext. Never commit the key.
# BACKUP_ENCRYPTION_KEY=<64 hex characters>
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
