JWT_SECRET=
SESSION_TTL_DAYS=7
COOKIE_NAME=sid
TRUST_PROXY=0
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-random-64-character-secret
SEED_ADMIN_EMAIL=aleksejdrachuk10@gmail.com
SEED_ADMIN_PASSWORD=1234567890
# Without SMTP in development, reset emails go to server/storage/mail-outbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.test
