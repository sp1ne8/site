    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.0.13",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "^6.19.0",
    "supertest": "^7.1.4"
  }
