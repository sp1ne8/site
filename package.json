{
  "name": "subscription-starter",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.js",
    "dev": "concurrently -k -n api,web \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:generate": "npm run db:generate -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "test": "npm run test -w server",
    "test:integration": "npm run test:integration -w server",
    "sandbox:pay": "npm run sandbox:pay -w server --",
    "orders:expire": "npm run orders:expire -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "deepmerge-ts": "^8.0.0"
  },
  "overrides": {
    "deepmerge-ts": "$deepmerge-ts"
  }
}
